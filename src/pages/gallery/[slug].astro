---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Img from '../../components/Img.astro';
import { getAlbums, albumCover } from '../../lib/utils';
import { aspect, resolveImage } from '../../lib/img';

export async function getStaticPaths() {
  const albums = await getAlbums();
  return albums.map((album, i) => ({
    params: { slug: album.id },
    props: { album, prev: albums[i - 1], next: albums[i + 1] },
  }));
}

const { album, prev, next } = Astro.props;
const a = album.data;
const single = a.images.length === 1;
---
<Base title={a.title} description={a.description || `${a.title} — photo album.`} image={resolveImage(albumCover(album))?.src}>
  <section class="page-hero">
    <div class="container">
      <a href="/gallery/" class="back"><Icon name="arrow-left" size={16} /> All albums</a>
      <p class="eyebrow">{a.category}{a.period && ` · ${a.period}`}</p>
      <h1>{a.title}</h1>
      {a.description && <p class="lead">{a.description}</p>}
      <p class="muted count mono">{a.images.length} {single ? 'photo' : 'photos'}</p>
    </div>
  </section>

  <section class="container">
    <div class:list={['justified', { single }]}>
      {a.images.map((p, i) => {
        const alt = p.caption || `${a.title} — photo ${i + 1}`;
        return (
          <a href={resolveImage(p.src)!.src} class="ph" style={`--r:${aspect(p.src).toFixed(4)}`} data-lb={album.id} data-caption={p.caption ?? ''} data-alt={alt}>
            <Img src={p.src} alt={alt} sizes={single ? '(max-width: 900px) 100vw, 900px' : '(max-width: 640px) 50vw, 33vw'} max={800} loading={i < 4 ? 'eager' : 'lazy'} />
            {p.caption && <span class="cap">{p.caption}</span>}
          </a>
        );
      })}
    </div>

    {(prev || next) && (
      <nav class="pager" aria-label="Other albums">
        {prev && <a href={`/gallery/${prev.id}/`} class="card card-hover pg"><small><Icon name="arrow-left" size={14} /> Previous</small><span>{prev.data.title}</span></a>}
        {next && <a href={`/gallery/${next.id}/`} class="card card-hover pg next"><small>Next <Icon name="arrow-right" size={14} /></small><span>{next.data.title}</span></a>}
      </nav>
    )}
  </section>
</Base>

<style>
  .back { display: flex; align-items: center; gap: 6px; width: fit-content; margin-bottom: 18px; font-size: 0.9rem; font-weight: 600; }
  .count { margin: 10px 0 0; font-size: 0.82rem; }
  /* Justified rows: each tile grows in proportion to its aspect ratio. */
  .justified { --row: 260px; display: flex; flex-wrap: wrap; gap: 8px; }
  .justified:after { content: ""; flex-grow: 999999; }
  .ph {
    position: relative; display: block; overflow: hidden; border-radius: 10px; background: var(--surface-2); cursor: zoom-in;
    aspect-ratio: var(--r); flex-grow: calc(var(--r) * 100); flex-basis: calc(var(--r) * var(--row)); max-width: calc(var(--r) * var(--row) * 1.8);
  }
  .ph :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.3s; }
  .ph:hover :global(img) { transform: scale(1.04); }
  .cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 24px 12px 10px; background: linear-gradient(transparent, #030712b3); color: #fff; font-size: 0.82rem; }
  .single { justify-content: center; }
  .single .ph { flex: 0 auto; width: min(100%, calc(70vh * var(--r)), 900px); max-width: none; }
  .single:after { display: none; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 40px; }
  .pg { display: flex; flex-direction: column; gap: 4px; padding: 16px 18px; color: var(--text); }
  .pg:hover { text-decoration: none; }
  .pg small { display: inline-flex; align-items: center; gap: 5px; color: var(--muted); font-size: 0.8rem; }
  .pg span { font: 600 0.98rem var(--font-display); }
  .pg.next { grid-column: 2; align-items: flex-end; text-align: right; }
  @media (width <= 900px) { .justified { --row: 190px; } }
  @media (width <= 640px) {
    .justified { --row: 130px; gap: 5px; }
    .ph { border-radius: 7px; }
    .pager { grid-template-columns: 1fr; }
    .pg.next { grid-column: 1; }
  }
</style>
