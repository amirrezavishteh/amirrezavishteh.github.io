---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Img from '../../components/Img.astro';
import profile from '../../data/profile.json';
import { getAlbums, albumCover } from '../../lib/utils';

const albums = await getAlbums();
const photos = albums.reduce((n, a) => n + a.data.images.length, 0);
const cats = (['Academic', 'Life'] as const).map((c) => [c, albums.filter((a) => a.data.category === c).length] as const).filter(([, n]) => n);
---
<Base title="Gallery" description={`Photos from ${profile.name}: lab life, campus, friends, nature, and the dogs.`}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Gallery</p>
      <h1>Moments</h1>
      <p class="lead">{albums.length} albums · {photos} photos — lab life and campus, plus the friends, mountains, and dogs that keep research in balance.</p>
    </div>
  </section>

  <section class="container" data-filter-scope>
    <div class="filters" role="group" aria-label="Filter albums">
      <button class="filter-btn" data-filter="all" aria-pressed="true">All <span class="count">{albums.length}</span></button>
      {cats.map(([c, n]) => <button class="filter-btn" data-filter={c} aria-pressed="false">{c} <span class="count">{n}</span></button>)}
    </div>
    <div class="albums">
      {albums.map((a, i) => (
        <a href={`/gallery/${a.id}/`} class="album" data-item data-cats={a.data.category}>
          <div class="cover">
            <Img src={albumCover(a)!} alt={a.data.title} sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 380px" max={800} loading={i < 3 ? 'eager' : 'lazy'} />
            <span class="n"><Icon name="image" size={13} /> {a.data.images.length}</span>
          </div>
          <div class="info">
            <span class="cat mono">{a.data.category}{a.data.period && ` · ${a.data.period}`}</span>
            <h2>{a.data.title}</h2>
            {a.data.description && <p>{a.data.description}</p>}
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .albums { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: clamp(14px, 2vw, 24px); }
  .album {
    display: flex; flex-direction: column; overflow: hidden; color: inherit;
    border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface);
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .album:hover { box-shadow: var(--shadow); text-decoration: none; transform: translateY(-4px); }
  .cover { position: relative; aspect-ratio: 4/3; overflow: hidden; background: var(--surface-2); }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .album:hover .cover :global(img) { transform: scale(1.05); }
  .n {
    position: absolute; top: 10px; right: 10px; display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px;
    border-radius: 999px; background: #03071299; color: #fff; font: 500 0.78rem var(--font-mono);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  }
  .info { display: flex; flex-direction: column; gap: 6px; padding: 16px 18px 20px; }
  .cat { color: var(--brand); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .info h2 { margin: 0; font-size: 1.1rem; }
  .info p { margin: 0; color: var(--muted); font-size: 0.9rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>

<script>
  import { initFilters } from '../../scripts/filter';
  initFilters();
</script>
