---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { LANG_COLORS, linkAttrs } from '../lib/utils';
import { getStars, repoSlug } from '../lib/github';

interface Props {
  project: CollectionEntry<'projects'>;
  maxTopics?: number;
}
const { project, maxTopics = 3 } = Astro.props;
const p = project.data;
const primary = p.repo || p.demo || p.post;
const stars = (await getStars(p.repo)) ?? p.stars ?? 0;
const topics = p.topics.slice(0, maxTopics);
const more = p.topics.length - topics.length;
const text = [p.title, p.description, ...p.topics, p.language, p.category].filter(Boolean).join(' ').toLowerCase();
---
<article class="project card card-hover" data-item data-cats={p.category} data-text={text} id={project.id}>
  <div class="top">
    <span class="cat">{p.category}</span>
    {p.period && <span class="period mono">{p.period}</span>}
  </div>
  <h3>{primary ? <a {...linkAttrs(primary)} class="stretched">{p.title}</a> : p.title}</h3>
  {p.fork && p.upstream && (
    <p class="fork-note"><Icon name="fork" size={13} /> Fork of {repoSlug(p.upstream) ?? p.upstream}</p>
  )}
  <p class="desc">{p.description}</p>
  {topics.length > 0 && (
    <div class="chips">
      {topics.map((t) => <span class="chip">{t}</span>)}
      {more > 0 && <span class="chip">+{more}</span>}
    </div>
  )}
  <div class="foot">
    {p.language && <span class="lang"><i style={`background:${LANG_COLORS[p.language] ?? 'var(--muted)'}`}></i>{p.language}</span>}
    {stars > 0 && <span class="stat" title="GitHub stars"><Icon name="star" size={14} /> {stars}</span>}
    <span class="spacer"></span>
    {p.post && p.post !== primary && <a class="demo" href={p.post}><Icon name="pen" size={14} /> Write-up</a>}
    {p.demo && p.demo !== primary && <a class="demo" {...linkAttrs(p.demo)}><Icon name="globe" size={14} /> Demo</a>}
    {p.repo && <span class="gh" aria-label="GitHub repository"><Icon name="github" size={16} /></span>}
    {!p.repo && p.demo && <span class="gh"><Icon name="globe" size={16} /></span>}
    {!p.repo && !p.demo && p.post && <span class="gh"><Icon name="pen" size={16} /></span>}
  </div>
</article>

<style>
  .project { display: flex; flex-direction: column; gap: 8px; min-height: 100%; padding: 20px; scroll-margin-top: calc(var(--header-h) + 24px); }
  .project:target { border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-soft); }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .cat { font: 500 0.72rem var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--brand); }
  .period { color: var(--muted); white-space: nowrap; font-size: 0.75rem; }
  h3 { margin: 0; font-size: 1.08rem; overflow-wrap: anywhere; }
  h3 a { color: var(--text); }
  h3 a:hover { color: var(--brand); text-decoration: none; }
  .stretched:after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .fork-note { display: flex; align-items: center; gap: 5px; margin: 0; color: var(--muted); font-size: 0.8rem; }
  .desc {
    margin: 0; color: var(--text-2); font-size: 0.92rem;
    display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;
  }
  .chips { margin-top: 4px; }
  .chip { padding: 2px 9px; font-size: 0.74rem; }
  .foot { display: flex; align-items: center; gap: 14px; margin-top: auto; padding-top: 12px; color: var(--muted); font-size: 0.84rem; }
  .lang { display: inline-flex; align-items: center; gap: 6px; }
  .lang i { width: 10px; height: 10px; border-radius: 50%; }
  .stat { display: inline-flex; align-items: center; gap: 4px; }
  .spacer { flex: 1; }
  .demo { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 4px; font-weight: 600; }
  .gh { color: var(--muted); }
</style>
